NODE_ENV=development
PORT=3000
SITE_URL=https://www.staketruth.com

# JWT
JWT_SECRET=YOUR_LONG_RANDOM_64_CHAR_SECRET
JWT_EXPIRES_IN=7d

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=staketruth
DB_USER=staketruth_user
DB_PASSWORD=YOUR_DB_PASSWORD

# API-Football (api-sports.io) — placeholder, get a real key at https://www.api-football.com
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_SEASON=2025

# The Odds API — placeholder, get a real key at https://the-odds-api.com
ODDS_API_KEY=YOUR_ODDS_API_KEY
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Paystack — placeholder, get real keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY

PAYSTACK_PLAN_MONTHLY_AMOUNT=7500
PAYSTACK_PLAN_QUARTERLY_AMOUNT=19500
PAYSTACK_PLAN_ANNUAL_AMOUNT=59900
PAYSTACK_PLAN_CURRENCY=NGN

# SMTP — placeholder, e.g. use a Brevo/SendGrid/Gmail app-password account
SMTP_HOST=smtp.YOUR_PROVIDER.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@staketruth.com
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM="StakeTruth <noreply@staketruth.com>"

# VIP Telegram
TELEGRAM_VIP_INVITE_LINK=https://t.me/+YOUR_INVITE_HASH

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# Scheduler
SYNC_CRON_SCHEDULE=0 6 * * *

# Intelligence Engine fallback defaults (live values read from intelligence_weights table)
INTELLIGENCE_MIN_CONFIDENCE=72
INTELLIGENCE_AUTO_PUBLISH_THRESHOLD=78
INTELLIGENCE_LEARNING_WEIGHT=0.5

# Google Search Console / AdSense verification (optional — paste the meta tag "content" value only)
GOOGLE_SITE_VERIFICATION=
ADSENSE_PUBLISHER_ID=
